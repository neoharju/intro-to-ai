diff --git a/scripts/build.mjs b/scripts/build.mjs
new file mode 100644
index 0000000..639a1a8
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,65 @@
+// Builds javascripts/main.js, stylesheets/main.css and fonts/vendor/* from src/.
+// The outputs are committed: GitHub Pages serves this branch as-is, without a build step.
+//
+//   npm run build          one-off build
+//   npm run build -- --watch
+import { rm } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import * as esbuild from 'esbuild';
+import * as sass from 'sass';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const watch = process.argv.includes('--watch');
+
+// Compiles SCSS with Dart Sass; esbuild then bundles the resulting CSS, including the plain
+// CSS @imports of vendor stylesheets and the fonts they reference.
+const sassPlugin = {
+  name: 'sass',
+  setup(build) {
+    build.onLoad({ filter: /\.scss$/ }, args => {
+      const result = sass.compile(args.path, {
+        loadPaths: [path.join(root, 'node_modules')],
+        quietDeps: true,
+        // Bootstrap 5 is consumed through @import; it has no module-system (@use) entry point.
+        silenceDeprecations: ['import'],
+      });
+
+      return {
+        contents: result.css,
+        loader: 'css',
+        resolveDir: path.dirname(args.path),
+        watchFiles: result.loadedUrls.filter(url => url.protocol === 'file:').map(url => fileURLToPath(url)),
+      };
+    });
+  },
+};
+
+const options = {
+  absWorkingDir: root,
+  entryPoints: {
+    'javascripts/main': 'src/javascripts/main.js',
+    'stylesheets/main': 'src/stylesheets/main.scss',
+  },
+  outdir: '.',
+  bundle: true,
+  minify: true,
+  format: 'iife',
+  // Browsers from 2020-2021 onwards (esbuild cannot down-level destructuring for Safari < 15)
+  target: ['chrome80', 'edge80', 'firefox78', 'safari15', 'ios15'],
+  loader: { '.woff2': 'file', '.woff': 'file', '.ttf': 'file' },
+  assetNames: 'fonts/vendor/[name]-[hash]',
+  // The MOOC logo font is a static file that is already in /fonts/mooc.
+  external: ['../fonts/mooc/*'],
+  plugins: [sassPlugin],
+  logLevel: 'info',
+};
+
+await rm(path.join(root, 'fonts', 'vendor'), { recursive: true, force: true });
+
+if (watch) {
+  const context = await esbuild.context(options);
+  await context.watch();
+} else {
+  await esbuild.build(options);
+}
diff --git a/src/javascripts/exercises.js b/src/javascripts/exercises.js
new file mode 100644
index 0000000..c139be8
--- /dev/null
+++ b/src/javascripts/exercises.js
@@ -0,0 +1,97 @@
+import { uniqueId, kebabCase, chunk } from 'lodash-es';
+import { scrollToId } from './utils';
+
+class Exercises {
+  mount() {
+    $('#exercise-list').on('click', '.exercise-list__link', this.onClickExerciseLink.bind(this));
+
+    this.headingNodes = $('.exercise h1, .exercise h2');
+    this.exerciseNodes = $('.exercise');
+    this.exerciseListNode = $('#exercise-list');
+
+    this.addIds();
+    this.addNumbers();
+    this.renderExecisesList();
+  }
+
+  addIds() {
+    this.exerciseNodes.each(function() {
+      const exerciseNode = $(this);
+      const collapseNode = exerciseNode.find('.collapse');
+      const toggleNode = exerciseNode.find('.exercise__toggle');
+      const headingNode = exerciseNode.find('.exercise__heading');
+
+      const id = `${uniqueId('exercise-')}-${kebabCase(headingNode.text())}`;
+
+      exerciseNode.attr('data-name', headingNode.text());
+      exerciseNode.attr('data-href', `#${id}`);
+      exerciseNode.attr('id', `${id}-root`);
+      collapseNode.attr('id', id);
+      toggleNode.attr('href', `#${id}`);
+    });
+  }
+
+  addNumbers() {
+    let indices = [];
+    const exerciseNames = [];
+
+    this.headingNodes.each(function() {
+      const headingNode = $(this);
+      const hIndex = parseInt(this.nodeName.substring(1)) - 1;
+
+      if(hIndex === 0) {
+        const exerciseNode = headingNode.closest('.exercise');
+
+        exerciseNames.push({
+          name: exerciseNode.attr('data-name'),
+          href: exerciseNode.attr('data-href')
+        });
+      }
+
+      if (indices.length - 1 > hIndex) {
+        indices = indices.slice(0, hIndex + 1 );
+      }
+
+      if (indices[hIndex] == undefined) {
+        indices[hIndex] = 0;
+      }
+
+      indices[hIndex]++;
+
+      headingNode.prepend(`
+        <small class="text-muted">
+          Exercise ${indices.join('.')}:
+        </small>
+      `);
+    });
+
+    this.exerciseNames = exerciseNames;
+  }
+
+  onClickExerciseLink(e) {
+    const id = `${e.currentTarget.getAttribute('href').substring(1)}-root`;
+
+    scrollToId(id);
+  }
+
+  // Built with DOM nodes rather than an HTML string: the names come from heading text.
+  renderExecisesList() {
+    const rows = chunk(this.exerciseNames, 3).map((exercises, rowIndex) => {
+      const rowNode = $('<div class="row"></div>');
+
+      exercises.forEach((exercise, index) => {
+        const linkNode = $('<a data-bs-toggle="collapse" class="exercise-list__link"></a>')
+          .attr('href', exercise.href)
+          .text(`Exercise ${rowIndex * 3 + index + 1}: ${exercise.name}`);
+
+        rowNode.append($('<div class="exercise-list__item col-12 col-md-6 col-lg-4"></div>').append(linkNode));
+      });
+
+      return rowNode;
+    });
+
+    this.exerciseListNode.empty().append(rows);
+  }
+}
+
+export default Exercises;
diff --git a/src/javascripts/main.js b/src/javascripts/main.js
new file mode 100644
index 0000000..a5839f8
--- /dev/null
+++ b/src/javascripts/main.js
@@ -0,0 +1,51 @@
+import $ from 'jquery';
+import 'bootstrap/js/src/collapse.js';
+import 'bootstrap/js/src/dropdown.js';
+import hljs from 'highlight.js/lib/core';
+import bash from 'highlight.js/lib/languages/bash';
+import java from 'highlight.js/lib/languages/java';
+import python from 'highlight.js/lib/languages/python';
+import 'cookieconsent';
+
+import Exercises from './exercises';
+import Solutions from './solutions';
+import TableOfContents from './table-of-contents';
+import Navigation from './navigation';
+
+// The page modules use the jQuery globals, as they did when jQuery came from a CDN.
+window.$ = window.jQuery = $;
+
+hljs.registerLanguage('bash', bash);
+hljs.registerLanguage('java', java);
+hljs.registerLanguage('python', python);
+
+function highlightCode() {
+  document.querySelectorAll('pre code').forEach(block => {
+    // highlight.js 11 no longer merges markup inside code blocks (e.g. <sub> in pseudocode),
+    // so such blocks keep their authored HTML and only get the code-block styling.
+    if (block.children.length > 0) {
+      block.classList.add('nohighlight', 'hljs');
+      return;
+    }
+
+    // Blocks are tagged with SHJS-style classes (sh_java, sh_bash, ...) on the <pre>.
+    const hint = block.parentNode.className.match(/\bsh_(\w+)/);
+
+    if (hint && hljs.getLanguage(hint[1])) {
+      block.classList.add(`language-${hint[1]}`);
+    }
+  });
+
+  hljs.highlightAll();
+}
+
+$(() => {
+  (new Exercises()).mount();
+  (new Solutions()).mount();
+  (new TableOfContents()).mount();
+  (new Navigation()).mount();
+
+  highlightCode();
+
+  window.cookieconsent.initialise({ palette: { popup: { background: '#000' }, button: { background: '#f1d600' } } });
+});
