+# GitHub Pages publishes this branch with Jekyll. Keep the build tooling out of the published site.
+# (Jekyll 3 replaces its default exclude list with this one, so node_modules is listed explicitly.)
+exclude:
+  - README.md
+  - SOURCES.md
+  - Dockerfile
+  - compose.yaml
+  - docker
+  - package.json
+  - package-lock.json
+  - node_modules
+  - scripts
+  - src
diff --git a/compose.yaml b/compose.yaml
new file mode 100644
index 0000000..f0bf9da
--- /dev/null
+++ b/compose.yaml
@@ -0,0 +1,34 @@
+# Local preview of the course site at http://localhost:4567
+#
+#   docker compose up --build    build the image and serve the site
+#   docker compose watch         same, and rebuild whenever a file changes
+name: intro-to-ai
+
+services:
+  site:
+    build:
+      context: .
+      target: site
+    image: intro-to-ai-site:local
+    ports:
+      # Loopback only: the preview is not exposed to the local network.
+      - "127.0.0.1:4567:8080"
+    read_only: true
+    tmpfs:
+      - /tmp:size=16m,mode=1777
+    cap_drop:
+      - ALL
+    security_opt:
+      - no-new-privileges:true
+    deploy:
+      resources:
+        limits:
+          cpus: "0.50"
+          memory: 64M
+          pids: 64
+    develop:
+      watch:
+        - action: rebuild
+          path: .
+          ignore:
+            - node_modules/
diff --git a/docker/nginx.conf b/docker/nginx.conf
new file mode 100644
index 0000000..7a3f752
--- /dev/null
+++ b/docker/nginx.conf
@@ -0,0 +1,75 @@
+# nginx configuration for the course-site container (see Dockerfile and compose.yaml).
+# Everything nginx writes goes to /tmp, so the container can run with a read-only root filesystem.
+
+# A fixed count: "auto" counts the host's CPUs, not the container's CPU quota.
+worker_processes 2;
+error_log /dev/stderr notice;
+pid /tmp/nginx.pid;
+
+events {
+    worker_connections 1024;
+}
+
+http {
+    client_body_temp_path /tmp/client_temp;
+    proxy_temp_path /tmp/proxy_temp;
+    fastcgi_temp_path /tmp/fastcgi_temp;
+    uwsgi_temp_path /tmp/uwsgi_temp;
+    scgi_temp_path /tmp/scgi_temp;
+
+    include /etc/nginx/mime.types;
+    default_type application/octet-stream;
+    charset utf-8;
+    charset_types text/css text/plain application/javascript application/json image/svg+xml;
+
+    access_log /dev/stdout;
+    sendfile on;
+    keepalive_timeout 65;
+    server_tokens off;
+
+    gzip on;
+    gzip_vary on;
+    gzip_comp_level 6;
+    gzip_min_length 1024;
+    gzip_types text/css text/plain application/javascript application/json image/svg+xml;
+
+    server {
+        listen 8080;
+        server_name _;
+        root /usr/share/nginx/html;
+        index index.html;
+
+        # Relative redirects (/week1 -> /week1/), so they work behind any published port.
+        absolute_redirect off;
+
+        # Revalidate on every load: this server is mostly used to preview edits.
+        expires -1;
+
+        # Response headers GitHub Pages cannot send. 'unsafe-inline' is still needed for the inline
+        # Google Analytics snippet and the onclick handlers in the navigation bar.
+        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com; font-src 'self'; connect-src 'self' https://www.google-analytics.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
+        add_header X-Content-Type-Options "nosniff" always;
+        add_header X-Frame-Options "DENY" always;
+        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
+        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()" always;
+        add_header Cross-Origin-Opener-Policy "same-origin" always;
+        add_header Cross-Origin-Resource-Policy "same-origin" always;
+
+        location / {
+            limit_except GET {
+                deny all;
+            }
+            try_files $uri $uri/ =404;
+        }
+
+        location = /healthz {
+            access_log off;
+            default_type text/plain;
+            return 200 "ok\n";
+        }
+
+        location ~ /\. {
+            return 404;
+        }
+    }
+}
