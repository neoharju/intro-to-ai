diff --git a/Dockerfile b/Dockerfile
new file mode 100644
index 0000000..240598b
--- /dev/null
+++ b/Dockerfile
@@ -0,0 +1,36 @@
+# Course site image: the front-end assets are built from src/ with Node, and the static site is
+# served by an unprivileged nginx. Base images are pinned by digest; update them deliberately
+# (tag and digest together), e.g. with Dependabot or Renovate.
+ARG NODE_IMAGE=node:24.22.1-alpine3.24@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53
+# The -slim variant: nginx without the optional modules and curl, which a static site does not need.
+ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.30.6-alpine3.24-slim@sha256:5d8bb9437d74a600ec5dbf90c035451c724dc33eac8d3a71078f6f8612c345f6
+
+FROM ${NODE_IMAGE} AS build
+WORKDIR /build
+
+# Dependencies first, so editing pages or sources does not reinstall them. `npm ci` installs
+# exactly what package-lock.json pins (with integrity hashes); .npmrc disables install scripts.
+# Behind a TLS-intercepting proxy, pass its CA: docker build --secret id=ca_bundle,src=ca.pem .
+COPY package.json package-lock.json .npmrc ./
+RUN --mount=type=cache,target=/root/.npm \
+    --mount=type=secret,id=ca_bundle,required=false \
+    if [ -s /run/secrets/ca_bundle ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/ca_bundle; fi; \
+    npm ci --no-audit --no-fund
+
+# The build context is limited by .dockerignore to the published site and the asset sources.
+COPY . .
+RUN npm run build \
+    && mkdir /site \
+    && cp -R index.html LICENSE week* img files fonts javascripts stylesheets /site/
+
+FROM ${NGINX_IMAGE} AS site
+COPY docker/nginx.conf /etc/nginx/nginx.conf
+# Content stays owned by root: the nginx user (101) can read it but not modify it.
+COPY --from=build /site/ /usr/share/nginx/html/
+USER 101:101
+EXPOSE 8080
+HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
+    CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
+# nginx runs directly as PID 1; the upstream entrypoint scripts only rewrite configuration,
+# which this image neither needs nor allows (read-only root filesystem).
+ENTRYPOINT ["nginx", "-g", "daemon off;"]
diff --git a/README.md b/README.md
new file mode 100644
index 0000000..cc57c36
--- /dev/null
+++ b/README.md
@@ -0,0 +1,71 @@
+# Introduction to Artificial Intelligence: personal copy
+
+This is my personal copy of the course material for **Introduction to AI**, a course at the Department of
+Computer Science, University of Helsinki. I am only modifying it for my own use. It is not the official
+course, and it is not affiliated with or endorsed by the University of Helsinki or the course staff.
+
+## Credits
+
+The course material is the work of the course staff and the contributors of the original repository.
+Thank you for making it openly available.
+
+- Original repository: <https://github.com/materiaalit/intro-to-ai/tree/gh-pages>
+- Contributors: <https://github.com/materiaalit/intro-to-ai/graphs/contributors>
+- Official course site: <https://materiaalit.github.io/intro-to-ai/>
+
+## License
+
+The original material is licensed under the
+[Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International License](https://creativecommons.org/licenses/by-nc-sa/4.0/)
+(CC BY-NC-SA 4.0), included in [LICENSE](LICENSE). My changes are shared under the same license, and this
+copy is for non-commercial use only.
+
+## What I changed
+
+Compared with the original `gh-pages` branch (commit `b9dedeb`):
+
+- **Front-end dependencies:** jQuery, Bootstrap, highlight.js, Font Awesome and the Roboto font are upgraded
+  and served from this repository instead of third-party CDNs. The shared JavaScript and CSS are built from
+  `src/`.
+- **Docker preview:** a `Dockerfile` and `compose.yaml` to preview the site locally.
+- **Corrections in weeks 1–7:** factual errors and broken code examples are corrected. Every correction is
+  listed with its sources in [SOURCES.md](SOURCES.md).
+
+## Preview locally
+
+GitHub Pages publishes this branch as it is. The pages are plain HTML (`index.html`, `week1/` to `week7/`).
+To preview them:
+
+```bash
+docker compose up --build
+```
+
+The site is served at <http://localhost:4567>. `docker compose watch` rebuilds the image whenever a file
+changes.
+
+## Rebuild the assets
+
+The shared JavaScript, CSS and fonts in `javascripts/`, `stylesheets/` and `fonts/vendor/` are built from
+`src/` and committed, because GitHub Pages does not run a build. After changing `src/` or the dependencies:
+
+```bash
+npm ci
+npm run build
+```
+
+Then commit the changes in `javascripts/`, `stylesheets/` and `fonts/vendor/`.
+
+## Update dependencies
+
+Front-end libraries are pinned in `package.json` and `package-lock.json`, and npm never runs install
+scripts (`.npmrc`). To upgrade, change the versions in `package.json`, resolve them with a release cooldown
+so that newly published (possibly compromised) versions are skipped, rebuild, and check the pages:
+
+```bash
+npm install --before="$(date -u -d '14 days ago' +%Y-%m-%d)"
+npm run build
+```
+
+On macOS, use `date -u -v-14d +%Y-%m-%d` for the date.
+
+The base images in the `Dockerfile` are pinned by digest: update the tag and the digest together.
