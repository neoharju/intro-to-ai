+          border-right: 0.5rem solid transparent;
+          border-left: 0.5rem solid transparent;
+          transition: 0.5s;
+          transform: rotate3d(1, 0, 0, 0deg);
+        }
+
+        i {
+          transition: 0.5s;
+        }
+
+        &[aria-expanded=true] {
+          padding-bottom: $spacer-y;
+
+          &:after {
+            transform: rotate3d(1, 0, 0, 180deg);
+            transition: 0.5s;
+          }
+        }
+      }
+    }
+  }
+}
+
+.material {
+  padding-top: $spacer-y * 3 !important;
+}
